// Globals

serviceMod;;


/*
 * APIClient
 *
 * Make an API client object. If you want websockets, and you do, call connect() on the object. When
 * a client certificate is required, this will prompt the user in the browser to specify a cert from
 * the OS store. However for NodeJS you must specify a PKCS#12 (.p12) certificate bundle in advance.
 *
 * Options:
 *  {
 *      url:            <string>                // URL of the remote server, optionally with guid etc.
 *      guid:           <string>                // shared secret for access to remote server
 *      pfx:            <blob>                  // client certificate bundle
 *      passphrase:     <string>                // decryption key for pfx
 *  }
 *
 */

closure APIClient(imp, options, local client, url, urlob, guid) {
    global(App, serviceMod, URL)
    client = new(object, this)
    options = merge({
    }, options)
    if !options.url.match(RegExp("^(ws|http)s?://", "i"))
        options.url = "http://${options.url}"                               // a protocol is required
    try {
        urlob = xnew(URL, options.url)
    } catch {
        debuglog("APIClient: bad URL", options.url, exception)
        urlob = { }
    }
    if urlob.protocol == "https:" || urlob.protocol == "wss:"
        client.tls = true
    options.url = client.url = url = urlob.toString()
    if !options.guid && urlob.searchParams.get("guid")
        options.guid = urlob.searchParams.get("guid")
    client.guid = options.guid
    client.notifyAfter = 0
    client.requester = clirRequester()

    // connect
    //
    // For secure connections this automatically makes a GET request on the root to ensure that any
    // required client TLS certificate is presented before we attempt websocket communication.
    // Without this browsers like Chrome may fail the connection.
    //
    client.connect = function connect(local error) {
        if !client.wesc
            client.wesc = WebSocketClient(imp, options)
        if client.tls
            `(error) = clientRequest(url, {                                 // present client cert if any
                pfx: options.pfx || undefined                               // not specified here in browser
                passphrase: options.passphrase || undefined
            })
        if !error
            `(error) = client.wesc.connect()
        if error {
            ErrorDebuglog("APIClient: cannot connect to", url, error)
            return (list(error))
        }
        client.serverID = client.wesc.serverID                              // serverID
        list(false, { connected: true })
    }

    // clientRequest()
    //
    // Append our guid to the headers.
    //
    closure clientRequest(url, reqops) {
        reqops = merge(reqops)
        if options.guid
            reqops.headers = [list("x-naanlang-api-guid", options.guid)]
        client.requester(url, reqops)
    }

    // docs
    //
    // Here out of history.
    //
    client.docs = closure docs(local error, content, extra) {
        `(error, content, extra) = clientRequest(url)
        printline(content)
    }

    // status
    //
    // Does a long request poll, from the era before websockets.
    //
    client.status = closure status(cbStatus, timeoutms, local query, error, content, extra, queued) {
        query = EncodeQuery("status/?", {
            timeout: timeoutms
            after: client.notifyAfter
        })
        `(error, content, extra) = clientRequest(url.concat(query), { retrier: false }) // don't retry inside
        if (error || extra.status != 200)
            cbStatus()
        else if (length(content) == 0)
            cbStatus([])
        else {
            queued = new(content)
            queued.forEach(function(item, index, array) {
                if client.notifyAfter < item.stamp
                    client.notifyAfter = item.stamp
            })
            cbStatus(queued)
        }
    }

    // get
    //
    // Do a regular GET request.
    //
    client.get = closure get(path, options, local requrl, error, content, extra) {
        if App.cache
            requrl = url.concat(EncodeQuery(path.concat("?"), { naanver: App.cache }))
        else
            requrl = url.concat(path)
        `(error, content, extra) = clientRequest(requrl)
        if !error && extra.status != 200
            error = Error("readFile failed: ".concat(extra.status), {
                    status: extra.status
                })
        if error
            list(error)
        else
            list(error, content, extra)
    }

    // readFile
    //
    // Read a file at the specified path.
    //
    client.readFile = closure readFile(filepath, options, local query, error, content, extra) {
        query = EncodeQuery("readfile/?", {
            path: filepath
        })
        `(error, content, extra) = clientRequest(url.concat(query), options)
        if !error && extra.status != 200
            error = Error("readFile failed: ".concat(extra.status), {
                    status: extra.status
                })
        if error
            list(error)
        else
            list(error, content, extra)
    }

    // psmRemote
    //
    // Perform an operation and call back when done.
    //
    client.psmRemote = closure psmRemote(options, data, callback, 
        local query, reqOptions, error, content, extra) {
        query = EncodeQuery("psm/?", options)
        reqOptions = {
            putdata: data
        }
        if !data
            reqOptions.encoding = options.encoding                          // expected response format
        else if options.encoding == "binary"
            reqOptions.contentType = "application/octet-stream"             // we are sending binary data
        else if options.encoding == "json" {
            reqOptions.contentType = "application/json;charset=UTF-8"       // we are sending JSON
            `(error, data) = JsonStringify(data)
            if error
                return (callback(Error("psmRemote encoding failed:", error)))
            reqOptions.putdata = data
        }
        `(error, content, extra) = clientRequest(url.concat(query), reqOptions)
        if !error && extra.status != 200
            error = Error("NodeFS request failed: ".concat(extra.status), {
                    status: extra.status
                })
        if error
            callback(error)
        else
            callback(error, content)
    }
    
    // destroy
    //
    // Close down the client and release all resources.
    //
    client.destroy = closure destroy() {
        debuglog("API client destroyed")                                    // ### not pretty, but uncommon
        client.wesc.destroy()
        client.wesc = false
    }
    
    // finis

    client
};


/* 
 * WebSocketClient
 *
 * WebSocket client for websocket communications with a server. The Instance Messaage Processor (IMP)
 * handles routing between instances using intermediaries.
 *
 * Options:
 *  {
 *      url:            <string>                // hostname or URL of the remote server
 *      guid:           <string>                // shared secret for access to remote server
 *      pfx:            <blob>                  // client certificate bundle
 *      passphrase:     <string>                // decryption key for pfx
 *  }
 *
 */

closure WebSocketClient(imp, options, local wesc, ws, pending) {
    global(js)
    wesc = new(object, this)
    

    // reconnect
    //
    // Attempt to reconnect if needed, returning false on success or an error tuple otherwise.
    //
    function reconnect() {
        if !ws || wesc.fatal || pending {
            connect()                                                       // try to connect
            if wesc.fatal
                return (list(wesc.fatal))
        }
        false
    }

    // connect
    //
    // Establish a websocket connection with the host.
    //
    wesc.connect = closure connect(local url, result, error) {
        if ws {
            if pending
                return (pending.wait())                                     // connect in process
            if !wesc.fatal
                return(list(false, { connected: true }))                    // already open
        }

        // onopen
        // The WebSocket connection is now open.
        function onopen(e) {
            if wesc.impconn {
                result = wesc.impconn.reopen()
                pending.signal(result)
                return
            }
            wesc.impconn = imp.requester(function(data, local error, text) {
                if !pending && reconnect()                                  // !pending means not opening/reopening
                    return                                                  // failed to reconnect
                `(error, text) = JsonStringify(data)
                if error
                    return (list(error))
                ws.send(text)
                list(false, { sent: true })
            }, {
                secret: options.guid
                label: "api-server"
            })
            wesc.impconn.addEventListener("active", function (event, info) {
                wesc.serverID = info.destID                                 // serverID we connected to
                pending.signal(list(false, { ok: true }))
                pending = false
            })
        }

        // onmessage
        // A message was received via WebSockets.
        function onmessage(e, local error, message) {
            `(error, message) = JsonParse(e.data)
            if !error {
                message = new(message)
                if wesc.impconn.dispatch(message)
                    return
            }
            pending.signal(list(Error("incompatible responder")))
            pending = false
            debuglog("socket message:", e.data)                             // unexpected incoming data
        }

        // onerror
        // An error occurred on the WebSocket connection.
        // This can happen in normal operation when the connection times out.
        function onerror(e) {
            if !wesc.fatal
                wesc.fatal = Error("websocket failed", e)
            pending.signal(list(wesc.fatal))
            pending = false
        }
        
        // onclose
        // The WebSocket connection was closed.
        function onclose(e) {
            // if e.code != 1000 && e.code != 1001 && e.code != 1005 && e.code != 1006
                debuglog("WebSocketClient: closed:", e.code, e.reason)      // ### not pretty to see this
            ws = false
            if !wesc.fatal
                wesc.fatal = Error("websocket closed", e.code, e.reason)
            pending.signal(list(wesc.fatal))
            pending = false
        }

        options = merge(options, {
            onopen: onopen.proc
            onmessage: onmessage.proc
            onerror: onerror.proc
            onclose: onclose.proc
        })
        `(error, ws) = call(clirWebsocket(), options.url, options)
        if error
            return (list(wesc.fatal = error))                               // failed to even get started

        if wesc.fatal
            debuglog("WebSocketClient reopen")                              // ### not pretty to see this
        wesc.fatal = false
        pending = new(nonce)
        result = pending.wait(10000, list(Error("IMP connection timeout")))
        pending = false
        result
    }

    // close
    //
    // Close the connection, but can be opened again with connect().
    //
    wesc.close = function close() {
        if ws
            ws.close(1000)                                                  // 1000: normal close
        ws = false
    }
    
    // destroy
    //
    // Destroy the connection permanently.
    //
    wesc.destroy = function destroy() {
        close()
        wesc.impconn.destroy()
        wesc.impconn = false
    }

    // send
    //
    // Send a message, returning result tuple.
    //
    wesc.send = closure send(data) {
        if reconnect()
            return                                                          // failed to reconnect
        wesc.impconn.send(data)
    }

    // sendRaw
    //
    // Send a message with reconnect but no routing. Returns a result tuple.
    //
    wesc.sendRaw = closure sendRaw(data) {
        if reconnect()
            return                                                          // failed to reconnect
        ws.send(data)
    }

    // finis
    wesc
};


/*
 * apicInit
 *
 * Initialize the apiclient component.
 *
 */

function apicInit(local manifest) {

    manifest = `(APIClient, WebSocketClient, apicInit)

    Naan.module.build(module.id, "apiclient", function(modobj, compobj) {
        Naan.module.require("./client.nlg")
        serviceMod = Naan.module.require("naanlib:frameworks/service/imp.nlg")
        compobj.manifest = manifest
        modobj.exports.APIClient = APIClient
    })

} ();
