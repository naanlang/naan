/*
 * WebSocket
 *
 * Create a WebSocket client connection object, returning a tuple.
 *
 * Required:
 *      urlstr:     <string>
 *
 * Options:
 *  {
 *      wss:        <boolean>                   // true to use secure connection
 *      query:      <string>                    // query string starting with ?
 *      onopen:     <proc>(e)                   // connection has opened
 *      onmessage:  <proc>(e, message)          // message received
 *      onerror:    <proc>(e)                   // error occurred
 *      onclose:    <proc>(e)                   // connection has closed
 *      pfx:        <blob>                      // client certificate bundle
 *      passphrase: <string>                    // decryption key for pfx
 *  }
 *
 */

closure WebSocket(urlstr, options, local error, wslib, url, reqOptions, crypto, bundle, ws) {
    `(error, wslib) = await(js.i("ws"))
    if error
        return (list(error))

    try {
        url = xnew(js.g.URL, urlstr)
    } catch {
        return (list(Error("invalid URL ${urlstr}", exception)))
    }
    options = merge({
        query: url.search || ''
        wss: url.protocol == "https:"
    }, options)
    if options.wss
        url = "wss://${url.host}${options.query}"
    else
        url = "ws://${url.host}${options.query}"
    reqOptions = {}
    if options.pfx {
        `(error, crypto) = await(js.i("node:crypto"))
        if error || !crypto.parsePKCS12
            return (list(Error("PKCS#12 bundles not supported in this NodeJS")))
        try {
            bundle = crypto.parsePKCS12(options.pfx, {
                passphrase: options.passphrase || undefined
            })
        } catch {
            return (list(Error("failed to parse PKCS#12 bundle", exception)))
        }
        if !bundle || !bundle.privateKey || !bundle.certificate
            return (list(Error("PKCS#12 bundle missing required elements")))
        reqOptions.cert = bundle.certificate.toString()
        reqOptions.key = bundle.privateKey.export({ type: 'pkcs8', format: 'pem' })
    }
    ws = xnew(wslib.default, url, reqOptions)
    ws.onopen = options.onopen
    ws.onmessage = options.onmessage
    ws.onerror = options.onerror
    ws.onclose = options.onclose
    list(false, ws)
};


/*
 * ws_clientInit
 *
 *     Initialize WebSocket client operations for browsers.
 *
 */

function ws_clientInit(local manifest) {
    manifest = `(WebSocket, ws_clientInit)

    Naan.module.build(module.id, "ws_client", function(modobj, compobj) {
        require("node.nlg")
        compobj.manifest = manifest
        modobj.exports.WebSocket = WebSocket
    })
}();
