/*
 * svcInit
 *
 * Initialize the service module.
 *
 */

function svcInit(local manifest) {
    manifest = `(svcInit)

    Naan.module.build(module.id, "service", function(modobj, compobj) {
        require("../common/common.nlg").LiveImport()
        compobj.manifest = manifest
    })
} ();
